# PAALS — Environment Configuration
# Copy this file to .env and fill in values as needed.
# The application runs fully without any API keys (uses mock agent by default).

# Optional: Anthropic API key — only needed if you want live LLM responses
# ANTHROPIC_API_KEY=sk-ant-...

# Kaggle DataCo dataset import (defaults shown)
# PAALS_KAGGLE_CSV=data/kaggle/DataCoSupplyChainDataset.csv
# Deviations in the last N days of the dataset on still-open orders stay active
# PAALS_KAGGLE_ACTIVE_DAYS=30

# Kaggle USAID SCMS dataset import (defaults shown)
# PAALS_SCMS_CSV=data/kaggle/scms/SCMS_Delivery_History_Dataset.csv
# Deviations in the last N days of the dataset stay active
# PAALS_SCMS_ACTIVE_DAYS=180

# Server settings (defaults shown)
HOST=127.0.0.1
PORT=8000
